{
  "manifest_version": 3,
  "name": "Mario Mojica - B2B Meet Translator",
  "version": "1.5.0",
  "description": "Traducción simultánea en tiempo real de Google Meet (Portugués ⟷ Español).",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Mario Mojica B2B Translator"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://mariomojica.com/*",
    "https://app.mariomojica.com/*",
    "https://clients5.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}