{
  "name": "3dBimFab Shield - Alertas de Intrusión por Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "3bf-security-alert",
        "options": {}
      },
      "id": "node-webhook-3bf",
      "name": "Webhook: 3dBimFab Shield Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "asunto",
              "value": "={{ $json.body.alerta.tipo.includes('INTRUSION') || $json.body.alerta.tipo.includes('NO_AUTORIZADO') ? '🚨 ALERTA: Intento de Intrusión en 3dBimFab' : '🛡️ Acceso Autorizado en 3dBimFab' }}"
            },
            {
              "name": "colorEncabezado",
              "value": "={{ $json.body.alerta.tipo.includes('INTRUSION') || $json.body.alerta.tipo.includes('NO_AUTORIZADO') ? '#e11d48' : '#0284c7' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-format-data",
      "name": "Formatear Asunto & Estilo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "seguridad@mariomojica.com",
        "toEmail": "mariomojica.style@gmail.com",
        "subject": "={{ $json.asunto }} (IP: {{ $json.body.alerta.ip }})",
        "html": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden;\">\n  <div style=\"background: {{ $json.colorEncabezado }}; padding: 20px; text-align: center; color: #ffffff;\">\n    <h2 style=\"margin: 0; font-size: 18px; font-weight: 700;\">{{ $json.asunto }}</h2>\n    <p style=\"margin: 6px 0 0 0; font-size: 13px; opacity: 0.9;\">3dBimFab Shield - Sistema de Detección en Tiempo Real</p>\n  </div>\n  <div style=\"padding: 24px; color: #334155; font-size: 14px; line-height: 1.6;\">\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600; width: 140px;\">Evento:</td><td style=\"padding: 8px 0; font-weight: 700;\">{{ $json.body.alerta.tipo }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600;\">Dirección IP:</td><td style=\"padding: 8px 0; font-family: monospace; font-size: 14px;\"><strong>{{ $json.body.alerta.ip }}</strong></td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600;\">Hora (Colombia):</td><td style=\"padding: 8px 0;\">{{ $json.body.alerta.fechaColombia }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600;\">Ruta solicitada:</td><td style=\"padding: 8px 0; font-family: monospace;\">{{ $json.body.alerta.ruta }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600;\">Clave probada:</td><td style=\"padding: 8px 0; font-family: monospace; color: #e11d48;\"><strong>{{ $json.body.alerta.claveIntentada || 'N/A' }}</strong></td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b; font-weight: 600;\">Dispositivo:</td><td style=\"padding: 8px 0; font-size: 12px; color: #475569;\">{{ $json.body.alerta.userAgent }}</td></tr>\n    </table>\n    <div style=\"margin-top: 24px; text-align: center;\">\n      <a href=\"https://3bf.mariomojica.com/api/access/logs\" style=\"display: inline-block; padding: 10px 24px; background: #0f172a; color: #ffffff; text-decoration: none; border-radius: 9999px; font-weight: 600; font-size: 13px;\">Ver Auditoría en Vivo</a>\n    </div>\n  </div>\n</div>"
      },
      "id": "node-send-email",
      "name": "Enviar Email a Mario Mojica",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook: 3dBimFab Shield Alert": {
      "main": [
        [
          {
            "node": "Formatear Asunto & Estilo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Asunto & Estilo": {
      "main": [
        [
          {
            "node": "Enviar Email a Mario Mojica",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
